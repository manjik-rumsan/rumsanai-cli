#!/usr/bin/env bash

CLAUDE_DIR="$HOME/.claude"
SETTINGS_FILE="$CLAUDE_DIR/settings.json"

OPENCODE_DIR="$HOME/.config/opencode"
OPENCODE_FILE="$OPENCODE_DIR/opencode.json"

case "$(uname -s)" in
    Darwin) VSCODE_DIR="$HOME/Library/Application Support/Code/User" ;;
    Linux)  VSCODE_DIR="$HOME/.config/Code/User" ;;
    *)      VSCODE_DIR="" ;;
esac
VSCODE_FILE="$VSCODE_DIR/chatLanguageModels.json"
VSCODE_ENTRY_NAME="Rumsan AI"

prompt_config() {
    echo

    DEFAULT_BASE_URL="https://ai.rumsan.net/v1"

    read -rp "ANTHROPIC_BASE_URL [$DEFAULT_BASE_URL]: " BASE_URL
    BASE_URL="${BASE_URL:-$DEFAULT_BASE_URL}"

    read -rsp "ANTHROPIC_AUTH_TOKEN: " AUTH_TOKEN
    echo

    while [[ -z "$AUTH_TOKEN" ]]; do
        read -rsp "ANTHROPIC_AUTH_TOKEN: " AUTH_TOKEN
        echo
    done

    echo "ANTHROPIC_MODEL options:"
    echo "  1) rs    (default)"
    echo "  2) free"
    read -rp "Choose [1]: " MODEL_CHOICE
    case "$MODEL_CHOICE" in
        2|free) MODEL="free" ;;
        1|rs|"") MODEL="rs" ;;
        *)
            echo "Unknown option, defaulting to rs"
            MODEL="rs"
            ;;
    esac
}

write_config() {

mkdir -p "$CLAUDE_DIR"

cat > "$SETTINGS_FILE" <<EOF
{
  "env": {
    "ANTHROPIC_BASE_URL": "$BASE_URL",
    "ANTHROPIC_AUTH_TOKEN": "$AUTH_TOKEN",
    "ANTHROPIC_MODEL": "$MODEL",
    "CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY": "1"
  },
  "model": "$MODEL",
  "theme": "dark",
  "hasCompletedOnboarding": true
}
EOF

echo
echo "✓ Claude configured."
}

enable_claude() {
    prompt_config
    write_config
}

disable_claude() {

if [[ -f "$SETTINGS_FILE" ]]; then
    rm "$SETTINGS_FILE"
    echo "✓ Claude configuration removed."
else
    echo "Claude is not configured."
fi

}

config_claude() {
    if [[ -f "$SETTINGS_FILE" ]]; then
        echo "Current configuration:"
        cat "$SETTINGS_FILE"
        echo
    fi

    prompt_config
    write_config
}

write_opencode_config() {

mkdir -p "$OPENCODE_DIR"

cat > "$OPENCODE_FILE" <<EOF
{
  "provider": {
    "9router": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "$BASE_URL",
        "apiKey": "$AUTH_TOKEN"
      },
      "models": {
        "$MODEL": {
          "name": "$MODEL",
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    }
  },
  "model": "9router/$MODEL",
  "agent": {
    "explorer": {
      "description": "Fast explorer subagent for codebase exploration",
      "mode": "subagent",
      "model": "9router/$MODEL"
    }
  }
}
EOF

echo
echo "✓ OpenCode configured."
}

enable_opencode() {
    prompt_config
    write_opencode_config
}

disable_opencode() {

if [[ -f "$OPENCODE_FILE" ]]; then
    rm "$OPENCODE_FILE"
    echo "✓ OpenCode configuration removed."
else
    echo "OpenCode is not configured."
fi

}

config_opencode() {
    if [[ -f "$OPENCODE_FILE" ]]; then
        echo "Current configuration:"
        cat "$OPENCODE_FILE"
        echo
    fi

    prompt_config
    write_opencode_config
}

copilot_instructions() {

DEFAULT_BASE_URL="https://ai.rumsan.net/v1"

cat <<EOF

GitHub Copilot has no direct config file for a custom base URL — it only
talks to its own proprietary endpoints. Routing it through the Rumsan
gateway (models: rs, free) requires MITM traffic interception via 9router,
not a config write. rumsanai cannot automate this (it needs a trusted root
CA and elevated privileges), but here's the manual flow:

  1. Install 9router:      https://github.com/decolua/9router
  2. Trust its root CA:    9router mitm install-cert
  3. Start interception:   9router mitm start --tool copilot
  4. In the 9router dashboard, map a Copilot model alias to your Rumsan
     gateway model ("rs" or "free"), using:
       Base URL:  $DEFAULT_BASE_URL
       API key:   (your ANTHROPIC_AUTH_TOKEN)

This installs a root CA into your system trust store and redirects DNS
for api.individual.githubcopilot.com to a local MITM server running on
port 443 — review 9router's own docs before proceeding.

EOF
}

vscode_copilot_manual_instructions() {
    echo
    echo "jq is required to safely edit chatLanguageModels.json without"
    echo "clobbering other configured providers. Install it (brew install jq /"
    echo "apt install jq) and re-run, or add this entry by hand via VS Code:"
    echo "Command Palette -> \"Chat: Manage Language Models\" -> Custom Endpoint"
    echo "-> Chat Completions, then point it at:"
    echo "  Base URL: $BASE_URL"
    echo "  API key:  (your ANTHROPIC_AUTH_TOKEN)"
    echo "  Model id: $MODEL"
}

write_vscode_copilot_config() {

    if [[ -z "$VSCODE_DIR" ]]; then
        echo "Automatic VS Code config isn't supported on this OS."
        echo "Base URL: $BASE_URL   API key: (your ANTHROPIC_AUTH_TOKEN)   Model id: $MODEL"
        return 1
    fi

    if ! command -v jq >/dev/null 2>&1; then
        vscode_copilot_manual_instructions
        return 1
    fi

    mkdir -p "$VSCODE_DIR"

    if [[ -f "$VSCODE_FILE" ]]; then
        EXISTING=$(cat "$VSCODE_FILE")
    else
        EXISTING="[]"
    fi

    NEW_ENTRY=$(jq -n \
        --arg name "$VSCODE_ENTRY_NAME" \
        --arg key "$AUTH_TOKEN" \
        --arg url "$BASE_URL" \
        --arg model "$MODEL" \
        '{
            name: $name,
            vendor: "customendpoint",
            apiKey: $key,
            apiType: "chat-completions",
            models: [{
                id: $model,
                name: ("Rumsan LLM Stack (" + $model + ")"),
                url: $url,
                toolCalling: true,
                vision: true,
                maxInputTokens: 128000,
                maxOutputTokens: 16000
            }]
        }')

    echo "$EXISTING" | jq --argjson entry "$NEW_ENTRY" \
        '[.[] | select(.name != $entry.name)] + [$entry]' > "$VSCODE_FILE"

    echo
    echo "✓ VS Code Copilot Chat configured ($VSCODE_FILE)."
    echo "  Note: the API key is stored in plaintext in that file."
    echo "  Reload VS Code, then pick \"Rumsan LLM Stack\" in the Copilot Chat model picker."
}

enable_vscode_copilot() {
    prompt_config
    write_vscode_copilot_config
}

disable_vscode_copilot() {

    if [[ ! -f "$VSCODE_FILE" ]]; then
        echo "VS Code Copilot is not configured."
        return
    fi

    if ! command -v jq >/dev/null 2>&1; then
        echo "jq is required to safely remove the entry."
        echo "Edit $VSCODE_FILE by hand and remove the \"$VSCODE_ENTRY_NAME\" entry."
        return 1
    fi

    jq --arg name "$VSCODE_ENTRY_NAME" '[.[] | select(.name != $name)]' \
        "$VSCODE_FILE" > "$VSCODE_FILE.tmp" && mv "$VSCODE_FILE.tmp" "$VSCODE_FILE"

    echo "✓ Rumsan AI entry removed from $VSCODE_FILE."
}

config_vscode_copilot() {
    if [[ -f "$VSCODE_FILE" ]]; then
        echo "Current configuration:"
        cat "$VSCODE_FILE"
        echo
    fi

    prompt_config
    write_vscode_copilot_config
}

interactive() {

echo
echo "Rumsan AI"
echo
echo "1) Claude"
echo "2) OpenCode"
echo "3) VS Code Copilot Chat"
echo "4) GitHub Copilot (CLI/other tools - manual setup instructions)"
echo
read -rp "Choose provider: " provider

case "$provider" in
    1)
        enable_fn=enable_claude
        disable_fn=disable_claude
        config_fn=config_claude
        ;;
    2)
        enable_fn=enable_opencode
        disable_fn=disable_opencode
        config_fn=config_opencode
        ;;
    3)
        enable_fn=enable_vscode_copilot
        disable_fn=disable_vscode_copilot
        config_fn=config_vscode_copilot
        ;;
    4)
        copilot_instructions
        exit 0
        ;;
    *)
        echo "Not implemented."
        exit 1
        ;;
esac

echo
echo "1) Enable"
echo "2) Disable"
echo "3) Config"
echo

read -rp "Choose action: " action

case "$action" in
    1)
        "$enable_fn"
        ;;
    2)
        "$disable_fn"
        ;;
    3)
        "$config_fn"
        ;;
    *)
        exit 1
        ;;
esac

}

case "$1" in

    --claude)

        case "$2" in
            enable)
                enable_claude
                ;;

            disable)
                disable_claude
                ;;

            config)
                config_claude
                ;;

            *)
                echo
                echo "Usage:"
                echo
                echo "rumsanai --claude enable"
                echo "rumsanai --claude disable"
                echo "rumsanai --claude config"
                ;;
        esac
        ;;

    --opencode)

        case "$2" in
            enable)
                enable_opencode
                ;;

            disable)
                disable_opencode
                ;;

            config)
                config_opencode
                ;;

            *)
                echo
                echo "Usage:"
                echo
                echo "rumsanai --opencode enable"
                echo "rumsanai --opencode disable"
                echo "rumsanai --opencode config"
                ;;
        esac
        ;;

    --vscode-copilot)

        case "$2" in
            enable)
                enable_vscode_copilot
                ;;

            disable)
                disable_vscode_copilot
                ;;

            config)
                config_vscode_copilot
                ;;

            *)
                echo
                echo "Usage:"
                echo
                echo "rumsanai --vscode-copilot enable"
                echo "rumsanai --vscode-copilot disable"
                echo "rumsanai --vscode-copilot config"
                ;;
        esac
        ;;

    --copilot)
        copilot_instructions
        ;;

    "")
        interactive
        ;;

    *)
        echo "Unknown command."
        ;;
esac