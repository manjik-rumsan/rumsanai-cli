#!/usr/bin/env bash

CLAUDE_DIR="$HOME/.claude"
SETTINGS_FILE="$CLAUDE_DIR/settings.json"

OPENCODE_DIR="$HOME/.config/opencode"
OPENCODE_FILE="$OPENCODE_DIR/opencode.json"

prompt_config() {
    echo

    DEFAULT_BASE_URL="https://ai.rumsan.net/v1"

    read -rp "ANTHROPIC_BASE_URL [$DEFAULT_BASE_URL]: " BASE_URL
    BASE_URL="${BASE_URL:-$DEFAULT_BASE_URL}"

    read -rsp "ANTHROPIC_AUTH_TOKEN: " AUTH_TOKEN
    echo

    while [[ -z "$AUTH_TOKEN" ]]; do
        read -rsp "ANTHROPIC_AUTH_TOKEN: " AUTH_TOKEN
        echo
    done

    echo "ANTHROPIC_MODEL options:"
    echo "  1) rs    (default)"
    echo "  2) free"
    read -rp "Choose [1]: " MODEL_CHOICE
    case "$MODEL_CHOICE" in
        2|free) MODEL="free" ;;
        1|rs|"") MODEL="rs" ;;
        *)
            echo "Unknown option, defaulting to rs"
            MODEL="rs"
            ;;
    esac
}

write_config() {

mkdir -p "$CLAUDE_DIR"

cat > "$SETTINGS_FILE" <<EOF
{
  "env": {
    "ANTHROPIC_BASE_URL": "$BASE_URL",
    "ANTHROPIC_AUTH_TOKEN": "$AUTH_TOKEN",
    "ANTHROPIC_MODEL": "$MODEL",
    "CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY": "1"
  },
  "model": "$MODEL",
  "theme": "dark",
  "hasCompletedOnboarding": true
}
EOF

echo
echo "✓ Claude configured."
}

enable_claude() {
    prompt_config
    write_config
}

disable_claude() {

if [[ -f "$SETTINGS_FILE" ]]; then
    rm "$SETTINGS_FILE"
    echo "✓ Claude configuration removed."
else
    echo "Claude is not configured."
fi

}

config_claude() {
    if [[ -f "$SETTINGS_FILE" ]]; then
        echo "Current configuration:"
        cat "$SETTINGS_FILE"
        echo
    fi

    prompt_config
    write_config
}

write_opencode_config() {

mkdir -p "$OPENCODE_DIR"

cat > "$OPENCODE_FILE" <<EOF
{
  "provider": {
    "9router": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "$BASE_URL",
        "apiKey": "$AUTH_TOKEN"
      },
      "models": {
        "$MODEL": {
          "name": "$MODEL",
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    }
  },
  "model": "9router/$MODEL",
  "agent": {
    "explorer": {
      "description": "Fast explorer subagent for codebase exploration",
      "mode": "subagent",
      "model": "9router/$MODEL"
    }
  }
}
EOF

echo
echo "✓ OpenCode configured."
}

enable_opencode() {
    prompt_config
    write_opencode_config
}

disable_opencode() {

if [[ -f "$OPENCODE_FILE" ]]; then
    rm "$OPENCODE_FILE"
    echo "✓ OpenCode configuration removed."
else
    echo "OpenCode is not configured."
fi

}

config_opencode() {
    if [[ -f "$OPENCODE_FILE" ]]; then
        echo "Current configuration:"
        cat "$OPENCODE_FILE"
        echo
    fi

    prompt_config
    write_opencode_config
}

interactive() {

echo
echo "Rumsan AI"
echo
echo "1) Claude"
echo "2) OpenCode"
echo
read -rp "Choose provider: " provider

case "$provider" in
    1)
        enable_fn=enable_claude
        disable_fn=disable_claude
        config_fn=config_claude
        ;;
    2)
        enable_fn=enable_opencode
        disable_fn=disable_opencode
        config_fn=config_opencode
        ;;
    *)
        echo "Not implemented."
        exit 1
        ;;
esac

echo
echo "1) Enable"
echo "2) Disable"
echo "3) Config"
echo

read -rp "Choose action: " action

case "$action" in
    1)
        "$enable_fn"
        ;;
    2)
        "$disable_fn"
        ;;
    3)
        "$config_fn"
        ;;
    *)
        exit 1
        ;;
esac

}

case "$1" in

    --claude)

        case "$2" in
            enable)
                enable_claude
                ;;

            disable)
                disable_claude
                ;;

            config)
                config_claude
                ;;

            *)
                echo
                echo "Usage:"
                echo
                echo "rumsanai --claude enable"
                echo "rumsanai --claude disable"
                echo "rumsanai --claude config"
                ;;
        esac
        ;;

    --opencode)

        case "$2" in
            enable)
                enable_opencode
                ;;

            disable)
                disable_opencode
                ;;

            config)
                config_opencode
                ;;

            *)
                echo
                echo "Usage:"
                echo
                echo "rumsanai --opencode enable"
                echo "rumsanai --opencode disable"
                echo "rumsanai --opencode config"
                ;;
        esac
        ;;

    "")
        interactive
        ;;

    *)
        echo "Unknown command."
        ;;
esac